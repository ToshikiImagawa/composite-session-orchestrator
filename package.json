{
  "name": "composite-session-orchestrator",
  "private": true,
  "version": "0.0.0",
  "description": "Composite pattern orchestrator for Claude sessions (integrator 1 : n workers)",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "biome check . && pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "format": "biome format --write .",
    "validate:plugin": "node scripts/validate-plugin.mjs",
    "check": "bash scripts/check.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.28.0",
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "fast-check": "4.10.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
